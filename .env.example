# Environment Mode (production / development / testing)
FLASK_ENV=production
FLASK_APP=wsgi.py

# Security Key - Generate a 32+ character random secret in production
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-very-secure-random-32-char-key

# Database Connection (PostgreSQL for production, SQLite for local dev)
# Example: postgresql://username:password@hostname:5432/bookish_db
DATABASE_URL=postgresql://user:pass@localhost:5432/bookish

# Real Paystack API Keys (from https://dashboard.paystack.com/#/settings/developer)
# Test mode: sk_test_... / pk_test_...
# Live mode: sk_live_... / pk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_your_actual_paystack_public_key
PAYSTACK_SECRET_KEY=sk_live_your_actual_paystack_secret_key

# Set to true only if you want to use the local interactive sandbox simulation
PAYSTACK_MOCK_ENABLED=false

# Full public domain where callbacks and webhooks resolve (Must be HTTPS in production)
SITE_URL=https://your-domain.example

# Production Security
SESSION_COOKIE_SECURE=true
